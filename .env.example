# Copy to .env and fill in values. Never commit real credentials.
SERVER_PORT=8080
APP_ENVIRONMENT=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ums
DB_USERNAME=ums
DB_PASSWORD=
# Optional: full JDBC URL overrides DB_HOST/DB_PORT/DB_NAME
# DB_URL=jdbc:postgresql://localhost:5432/ums
# DB_VALIDATE_ON_STARTUP=true
# DB_VALIDATION_TIMEOUT_SECONDS=2
